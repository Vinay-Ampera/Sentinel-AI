# Sentinel AI scanner image: the sandbox runner plus the Semgrep CLI and the bundled local rules.
#   make -C backend scanner-image SEMGREP_VERSION=<pinned release>
#
# Semgrep is a compiled tool, so this image is built by the OPERATOR with network access (pip
# install). Nothing is fetched at run time: the worker starts it with --network none, and the
# scan uses only the local rules below (--config <dir>, --metrics=off, no login, no registry).
# Verified 2026-10-23 with semgrep 1.182.1 (ADR-0008): the executor's fixed command ran
# offline in this image and every bundled rule loaded and fired. NOTE: `semgrep --validate`
# downloads extra lint rules from semgrep.dev, so it does NOT work offline; validate rules by
# running a scan (a broken rule makes the scan fail) or run --validate on a connected machine.
ARG BASE=sentinel-sandbox-runner:stage8
FROM ${BASE}

USER root
ARG SEMGREP_VERSION
RUN test -n "${SEMGREP_VERSION}" || (echo "pass --build-arg SEMGREP_VERSION=<pinned release>" >&2; exit 1)
RUN pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}"
COPY semgrep-rules/ /opt/sentinel/semgrep-rules/
RUN chmod -R a=rX /opt/sentinel/semgrep-rules

# Semgrep brings its own copies of PyYAML/rich/...: keep the vendored stack off its path.
ENV SENTINEL_PYTHONPATH=""
LABEL sentinel.scanner="semgrep" sentinel.scanner.version="${SEMGREP_VERSION}"
USER 65534:65534
