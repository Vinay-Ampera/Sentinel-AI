# Copy to backend/.env (untracked, git-ignored). Real values go ONLY there; never commit them
# and never paste them into chat, issues, logs, or prompts. Everything below is a PLACEHOLDER.
# Lines are commented out so copying this file changes nothing until you edit it.
#
# Labels:  [NOW]   read today (Alembic migrations and database tests)
#          [LATER] documented by the Stage 2 design; read when the named stage lands
#
# Loaded automatically by the app and Alembic (process environment variables take precedence).
# Use SENTINEL_ENV_FILE=/path/to/other.env to point at a different file.

# ============================ [NOW] Database ============================
# DATABASE_URL is the single source of truth for the backend database connection and for
# Alembic. Existing local database "sentinel-ai": application tables in schema public,
# authentication tables in schema app_user (both created by the migrations).
# URL-encode special characters in the password. For a cloud database later, change only
# this value (e.g. append ?sslmode=require).
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/sentinel-ai

# [NOW, optional tuning] connection pool and connect timeout
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_CONNECT_TIMEOUT_SECONDS=5

# [NOW, tests only] A DISPOSABLE database whose name ends in _test. The integration tests
# run `alembic downgrade base` on it, so it must never be the real database.
# TEST_DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/sentinel_ai_test

# ============================ [NOW] Runtime ============================
# APP_ENV=development                          # development | test | production
# LOG_LEVEL=INFO
# CORS_ALLOWED_ORIGINS=http://localhost:5173   # frontend origin allow-list
# REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379/0   # readiness probe now; Celery broker in Stage 7
# REDIS_TIMEOUT_SECONDS=2

# ================== [LATER: Stage 4] Sessions / auth (ADR-0002) ==========
# SESSION_TOKEN_PEPPER=                        # SECRET: >=32 random bytes, e.g. `openssl rand -base64 48`
# SESSION_COOKIE_NAME=sentinel_session
# SESSION_COOKIE_SECURE=true                   # false only for plain-HTTP local development
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
#LOGIN_IP_MAX_ATTEMPTS_PER_MINUTE = 15

# ============ [LATER: Stage 6/8] Artifacts, uploads, evidence storage =====
# ARTIFACT_STORAGE_BACKEND=local               # local | s3 | gcs
# ARTIFACT_STORAGE_DIR=./artifacts             # local backend only; git-ignored
# UPLOAD_MAX_MB=100
# ZIP_MAX_UNCOMPRESSED_MB=500
# ZIP_MAX_FILES=20000

# ================== [LATER: Stage 11] LLM (Gemini) ======================
# GEMINI_API_KEY=                              # SECRET
# GEMINI_MODEL=                                # chosen in Stage 11 (OPEN_QUESTIONS Q10)
# LLM_MAX_TOKENS_PER_RUN=200000                # defaults mirror seeded public.policies llm_limits
# LLM_MAX_COST_USD_PER_RUN=2.0
# LLM_MAX_COST_USD_PER_DAY=20.0
