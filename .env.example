# Copy to ./.env (repo root, untracked/git-ignored) ONLY if you use docker-compose.yml.
# Placeholders only; never commit real values. These are separate from backend/.env.
# REDIS_PASSWORD=CHANGE_ME_redis
# REDIS_HOST_PORT=6379
# Only for `--profile local-db` (a throw-away dev PostgreSQL, NOT your sentinel-ai database):
# POSTGRES_USER=sentinel
# POSTGRES_PASSWORD=CHANGE_ME_postgres
# POSTGRES_DB=sentinel_ai_dev
# POSTGRES_HOST_PORT=5433
#
# Matching backend/.env values for the Compose services:
#   REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
#   DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5433/sentinel_ai_dev
